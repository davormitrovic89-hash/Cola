# Kopie als .env anlegen (wird nicht committet). Echte Werte nie ins Repository oder in den Chat.

# Retell-API-Schlüssel, mit dem Retell Funktionsaufrufe und Webhooks signiert
# (welcher Schlüssel genau: in der aktuellen Retell-Doku prüfen, siehe retell/einstellungen.md).
RETELL_API_KEY=

# Port des Integrationsservers
PORT=8787

# Pfad der SQLite-Datenbank (Hosting: auf persistenten Speicher legen)
DATA_DIR=./data

# Nur für lokale Tests: unsignierte Anfragen von 127.0.0.1 erlauben.
# Wird ignoriert, sobald NODE_ENV=production gesetzt ist.
ALLOW_UNSIGNED_LOCAL=0

NODE_ENV=development
